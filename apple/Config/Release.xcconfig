#include "Shared.xcconfig"

// Release build: production backend and production short link host. Whole-module optimization.
API_BASE_URL = https:/$()/api.shared.kindrazki.dev
SHORT_LINK_HOST = https:/$()/shared.kindrazki.dev

SWIFT_OPTIMIZATION_LEVEL = -O
SWIFT_COMPILATION_MODE = wholemodule
GCC_OPTIMIZATION_LEVEL = s
ENABLE_TESTABILITY = NO
DEBUG_INFORMATION_FORMAT = dwarf-with-dsym
ONLY_ACTIVE_ARCH = NO
VALIDATE_PRODUCT = YES
