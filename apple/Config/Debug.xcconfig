#include "Shared.xcconfig"

// Debug build: points at the single production-accessible backend for now.
// We don't currently run a separate dev environment — update this when one exists.
// The `$()` token below is a no-op build-setting substitution that prevents xcconfig from
// treating "//" as the start of a comment when we embed URLs.
API_BASE_URL = https:/$()/api.fastsha.red
SHORT_LINK_HOST = https:/$()/fastsha.red

SWIFT_ACTIVE_COMPILATION_CONDITIONS = DEBUG
SWIFT_OPTIMIZATION_LEVEL = -Onone
SWIFT_COMPILATION_MODE = singlefile
GCC_PREPROCESSOR_DEFINITIONS = DEBUG=1 $(inherited)
ENABLE_TESTABILITY = YES
DEBUG_INFORMATION_FORMAT = dwarf
ONLY_ACTIVE_ARCH = YES
