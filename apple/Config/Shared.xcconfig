// Shared build settings for FastShared (app + extension + tests).
// DEVELOPMENT_TEAM is hardcoded to the project owner's Apple Developer team
// ("MATHEUS SALDANHA"). Forks will need to override locally via a
// Local.xcconfig + CODE_SIGN_IDENTITY_OVERRIDE pattern when that becomes a
// real need. For the single-maintainer setup this file is canonical.

DEVELOPMENT_TEAM = YFYB6NKC73

PRODUCT_BUNDLE_IDENTIFIER_PREFIX = dev.kindrazki.fastshared
APP_GROUP_IDENTIFIER = group.dev.kindrazki.fastshared
KEYCHAIN_ACCESS_GROUP = $(AppIdentifierPrefix)dev.kindrazki.fastshared

SWIFT_VERSION = 5.10

// MARKETING_VERSION: human-readable release version (CFBundleShortVersionString).
// Bumped on each public release following semver; CI may override for TestFlight
// pre-releases.
MARKETING_VERSION = 1.0.1

// CURRENT_PROJECT_VERSION: build number (CFBundleVersion). Must be monotonically
// increasing for every archive uploaded to App Store Connect under the same
// MARKETING_VERSION. CI is expected to overwrite this per build (e.g.
//   xcodebuild ... CURRENT_PROJECT_VERSION=$GITHUB_RUN_NUMBER
// ) so the committed value below is only a fallback for local archives.
CURRENT_PROJECT_VERSION = 1

IPHONEOS_DEPLOYMENT_TARGET = 17.0
MACOSX_DEPLOYMENT_TARGET = 14.0

CODE_SIGN_STYLE = Automatic
ENABLE_HARDENED_RUNTIME = YES
SWIFT_STRICT_CONCURRENCY = complete
CLANG_ANALYZER_NONNULL = YES

SHARED_BACKGROUND_SESSION_IDENTIFIER = dev.kindrazki.fastshared.upload
