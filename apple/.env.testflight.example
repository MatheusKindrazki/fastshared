# Copy to apple/.env.testflight and fill in. This file is gitignored.
# All three values come from App Store Connect → Users and Access → Integrations
# → App Store Connect API. Role: "App Manager" or "Developer" is enough.

APPSTORE_CONNECT_API_KEY_ID=XXXXXXXXXX
APPSTORE_CONNECT_API_KEY_ISSUER_ID=00000000-0000-0000-0000-000000000000

# Absolute path to the .p8 file downloaded from App Store Connect.
# Apple only lets you download the key ONCE — keep the file somewhere safe
# outside the repo. Example: ~/.config/fastshared/AuthKey_XXXXXXXXXX.p8
APPSTORE_CONNECT_API_KEY_PATH=/absolute/path/to/AuthKey_XXXXXXXXXX.p8

# Optional — surfaces as the build's release notes in TestFlight.
# FASTSHARED_CHANGELOG="Polished the hub and ephemeral timer. Action Button now uploads the last screenshot."
