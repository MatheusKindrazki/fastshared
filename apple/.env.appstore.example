# Copy to apple/.env.appstore.local for local App Store Connect metadata and
# submission runs. Keep the local file out of git.

# Optional override; defaults to MARKETING_VERSION in Config/Shared.xcconfig.
FASTSHARED_APPSTORE_VERSION=1.0.0

# Required for `make appstore-sync`, `make appstore-metadata`, and
# `make appstore-submit`. These values are sent to App Review, not shown on the
# public App Store page. Use real reachable contact details; the phone number
# must include a leading + and country code.
FASTSHARED_REVIEW_FIRST_NAME=Matheus
FASTSHARED_REVIEW_LAST_NAME=Kindrazki
FASTSHARED_REVIEW_PHONE="+55 11 99999 9999"
FASTSHARED_REVIEW_EMAIL=support@fastsha.red

# Submission guard. The submit lane refuses to run unless this is exactly YES.
FASTSHARED_SUBMIT_FOR_REVIEW=NO

# Use `latest` to let fastlane select the latest processed build, or set the
# exact CFBundleVersion already visible in App Store Connect.
FASTSHARED_SUBMIT_BUILD_NUMBER=latest

# Optional screenshot generator overrides. Leave empty unless the default
# simulator names are not installed on the machine running fastlane.
# FASTSHARED_SCREENSHOT_IPHONE_DESTINATION=platform=iOS Simulator,name=iPhone 17 Pro Max,OS=latest
# FASTSHARED_SCREENSHOT_IPAD_DESTINATION=platform=iOS Simulator,name=iPad Pro 13-inch (M5),OS=latest
# FASTSHARED_SCREENSHOT_MAC_DESTINATION=platform=macOS
# FASTSHARED_SCREENSHOT_MAC_EXPORT_TIMEOUT=90
