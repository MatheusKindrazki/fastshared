<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<!--
		    UserDefaults: consumed by RootView (has_seen_onboarding flag),
		    SettingsView, DeviceTokenStore fallback, and RetentionPolicy —
		    all within the same app + its App Group, never for cross-app
		    tracking. Reason: CA92.1 ("Access info from same app").
		-->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
		<!--
		    File timestamp APIs: UploadService and LastScreenshotFetcher
		    call FileManager.attributesOfItem(atPath:) on files the app has
		    already staged inside its own App Group container. We only read
		    file size but the attribute dictionary is backed by stat-family
		    calls. Reason: C617.1 ("Inside app container").
		-->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>C617.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
