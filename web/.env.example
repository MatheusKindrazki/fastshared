# FastShared web — environment variables
# Nothing is required for the current marketing site.
#
# Publications pages (landing, publish, account, pricing, terms, privacy, refund).
# Leave unset or false: the current site is unchanged, and the new routes
# answer with a noindex coming-soon page and no working form.
# PUBLIC_PUBLICATIONS_ENABLED=true
# PUBLIC_API_BASE=https://api.fastsha.red
#
# Reserved for later:
# ANALYTICS_KEY=
# PLAUSIBLE_DOMAIN=
