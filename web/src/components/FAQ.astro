---
interface QA {
  q: string;
  a: string;
}

const items: QA[] = [
  {
    q: 'How long do files live?',
    a: 'Free links can live up to 24 hours. Pro links can live up to 30 days. Every share has an expiry.',
  },
  {
    q: 'Does the recipient need FastShared?',
    a: 'No. They open the short link in any browser or messaging preview. The app is only needed to create and manage links.',
  },
  {
    q: 'Does it work on Mac?',
    a: 'Yes. The Mac app is built around a menu bar workflow, drag-and-drop uploads, paste-to-upload, and a structured recent-links list.',
  },
  {
    q: 'What happens when a link expires?',
    a: 'The public link returns 410 Gone and the file moves through the deletion workflow. Revoking a live link does the same thing immediately.',
  },
  {
    q: 'What about privacy?',
    a: 'Files live in a private Cloudflare R2 bucket. Reads are Worker-gated and short-lived. Recipients never sign in.',
  },
];
---
<section class="frame section-block" aria-labelledby="faq-heading">
  <header class="section-head reveal">
    <span class="section-num">Questions</span>
    <h2 id="faq-heading" class="section-title">The short version.</h2>
  </header>

  <div class="faq-list reveal reveal-delay-1">
    {items.map((item) => (
      <details class="faq-item">
        <summary>{item.q}</summary>
        <div class="faq-body">{item.a}</div>
      </details>
    ))}
  </div>
</section>
