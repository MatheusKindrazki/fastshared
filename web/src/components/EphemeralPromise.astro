---
const guarantees = [
  ['Recipient access', 'No account. The bearer link is the credential.'],
  ['Download path', 'Private bucket, Worker-gated resolve, short-lived signed reads.'],
  ['Cleanup', 'Expired links return 410 and move into deletion workflow.'],
];
---
<section
  class="promise-band"
  aria-labelledby="ephemeral-heading"
>
  <div class="frame promise-band__inner">
    <div class="promise-band__copy">
      <span class="section-num reveal">By design</span>
      <h2
        id="ephemeral-heading"
        class="promise-band__title reveal reveal-delay-1"
      >
        Every link expires. Every file has a deadline.
      </h2>
      <p class="promise-band__text reveal reveal-delay-2">
        FastShared is not another drive. It is a temporary handoff surface:
        upload, share, expire, delete.
      </p>
    </div>

    <div class="promise-ledger reveal reveal-delay-3">
      {guarantees.map(([label, value]) => (
        <div class="promise-ledger__row">
          <span>{label}</span>
          <strong>{value}</strong>
        </div>
      ))}
    </div>
  </div>
</section>
