---
// Hero — centered, confident, Apple-premium.
// Headline + subhead + CTA above an iPhone mockup showing the app.
import PlaneArc from './PlaneArc.astro';
import PhoneFrame from './PhoneFrame.astro';
---
<section
  class="frame relative pt-32 md:pt-44 pb-16 md:pb-24 flex flex-col items-center text-center"
  aria-labelledby="hero-headline"
>
  <!-- Eyebrow -->
  <span class="mono-eyebrow block mb-8 md:mb-10 reveal" data-testid="hero-eyebrow">
    FastShared
  </span>

  <!-- Headline -->
  <h1
    id="hero-headline"
    class="display-line font-display font-bold text-charcoal max-w-[900px] reveal reveal-delay-1"
    style="font-size: clamp(42px, 7.5vw, 104px); letter-spacing: -0.055em; line-height: 0.92;"
  >
    <span class="block">Share anything.</span>
    <span class="block">It disappears.</span>
  </h1>

  <!-- Subhead -->
  <p
    class="mt-8 md:mt-10 font-display text-[17px] md:text-[19px] leading-[1.55] text-charcoal/50 max-w-[520px] reveal reveal-delay-2"
  >
    Temporary share links for iPhone, iPad, and Mac. Pick an expiry, paste anywhere — the file deletes itself.
  </p>

  <!-- CTA -->
  <div class="mt-10 reveal reveal-delay-3">
    <a
      href="https://testflight.apple.com/join/fastshared"
      class="btn-primary"
      data-testid="hero-cta"
      target="_blank"
      rel="noopener noreferrer"
    >
      Join the TestFlight
      <span aria-hidden="true">→</span>
    </a>
  </div>

  <!-- iPhone Mockup -->
  <div class="mt-16 md:mt-24 w-full max-w-[340px] mx-auto reveal reveal-delay-4" data-hero-mockup>
    <PhoneFrame>
      <!-- App screen content inside the phone -->
      <div class="w-full h-full flex flex-col items-center justify-center gap-6 p-6 pt-16">
        <!-- App icon area -->
        <div class="relative">
          <PlaneArc size={72} animate ariaLabel="FastShared app icon" />
        </div>
        <!-- File card -->
        <div
          class="w-full rounded-2xl p-4 flex items-center gap-3"
          style="background: var(--surface-warm);"
        >
          <div class="w-10 h-10 rounded-xl bg-violet-hot/10 flex items-center justify-center flex-none">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--violet-hot)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
              <polyline points="14 2 14 8 20 8" />
            </svg>
          </div>
          <div class="flex-1 min-w-0 text-left">
            <p class="font-display text-[14px] font-medium text-charcoal truncate">screenshot.png</p>
            <p class="font-mono text-[11px] text-charcoal/40">2.4 MB · 24h</p>
          </div>
          <div class="w-8 h-8 rounded-full bg-violet-hot flex items-center justify-center flex-none">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12" />
            </svg>
          </div>
        </div>
        <!-- Link pill -->
        <div
          class="inline-flex items-center gap-2 px-4 py-2.5 rounded-full font-mono text-[12px] tracking-wide"
          style="background: var(--charcoal); color: var(--cream);"
        >
          <span class="w-2 h-2 rounded-full bg-green-400"></span>
          fastsha.red/s/a3f9
        </div>
        <p class="font-mono text-[11px] text-charcoal/35">Copied to clipboard</p>
      </div>
    </PhoneFrame>
  </div>
</section>
