---
// Rebranded hero — product mark, final tagline, and the core file/link/countdown flow.
---
<section
  class="brand-hero"
  aria-labelledby="hero-headline"
>
  <div class="brand-hero__scene" aria-hidden="true">
    <img
      src="/brand/appicon-1024.png"
      alt=""
      width="1024"
      height="1024"
      class="brand-hero__icon"
      decoding="async"
      loading="eager"
    />

    <div class="hero-transfer hero-transfer--file">
      <span class="hero-transfer__label">screen-recording.mov</span>
      <span class="hero-transfer__meta">284 MB · Pro</span>
    </div>

    <div class="hero-transfer hero-transfer--link">
      <span class="hero-transfer__label">fastsha.red/s/K9H4</span>
      <span class="hero-transfer__meta">copied</span>
    </div>

    <div class="hero-countdown">
      <span>expires in</span>
      <strong>23:59:41</strong>
    </div>
  </div>

  <div class="frame brand-hero__content">
    <span class="brand-hero__eyebrow reveal">
      <img src="/brand/appicon-1024.png" alt="" width="24" height="24" aria-hidden="true" />
      Native for iPhone, iPad, and Mac
    </span>

    <h1
      id="hero-headline"
      class="brand-hero__headline reveal reveal-delay-1"
    >
      <span>Share anything.</span>
      <span>Get a link.</span>
      <span>Watch it vanish.</span>
    </h1>

    <p class="brand-hero__copy reveal reveal-delay-2">
      FastShared turns any file into a temporary link on your clipboard.
      Recipients open it in a browser. The countdown handles the cleanup.
    </p>

    <div class="brand-hero__actions reveal reveal-delay-3">
      <a
        href="https://testflight.apple.com/join/fastshared"
        class="btn-primary"
        data-testid="hero-cta"
        target="_blank"
        rel="noopener noreferrer"
      >
        Join TestFlight
        <span aria-hidden="true">→</span>
      </a>
      <a href="#how" class="btn-ghost">
        See the flow
        <span aria-hidden="true">↓</span>
      </a>
    </div>

    <dl class="brand-hero__proof reveal reveal-delay-4">
      <div>
        <dt>Free</dt>
        <dd>100 MB · 24 h</dd>
      </div>
      <div>
        <dt>Pro</dt>
        <dd>2 GB · 30 d</dd>
      </div>
      <div>
        <dt>Storage</dt>
        <dd>Private R2</dd>
      </div>
    </dl>
  </div>
</section>
