---
// Product-first hero — no floating glass, no decorative oversized mark.
---
<section
  class="brand-hero"
  aria-labelledby="hero-headline"
>
  <div class="brand-hero__scene" aria-hidden="true">
    <div class="hero-manifest">
      <div class="hero-manifest__bar">
        <span>FastShared</span>
        <span>Transfer manifest</span>
      </div>
      <div class="hero-manifest__row">
        <span>File</span>
        <strong>screen-recording.mov</strong>
        <em>284 MB</em>
      </div>
      <div class="hero-manifest__row">
        <span>Link</span>
        <strong>fastsha.red/s/K9H4</strong>
        <em>Copied</em>
      </div>
      <div class="hero-manifest__row">
        <span>Expiry</span>
        <strong>23 h 59 min</strong>
        <em>Scheduled</em>
      </div>
      <div class="hero-manifest__row hero-manifest__row--quiet">
        <span>After</span>
        <strong>410 Gone</strong>
        <em>Deleted</em>
      </div>
    </div>
  </div>

  <div class="frame brand-hero__content">
    <span class="brand-hero__eyebrow reveal">
      <img src="/brand/appicon-1024.png" alt="" width="24" height="24" aria-hidden="true" />
      Temporary file links for Apple devices and agents
    </span>

    <h1
      id="hero-headline"
      class="brand-hero__headline reveal reveal-delay-1"
    >
      <span>Share anything.</span>
      <span>Get a link.</span>
      <span>Watch it vanish.</span>
    </h1>

    <p class="brand-hero__copy reveal reveal-delay-2">
      FastShared turns a file into a link you can paste anywhere. No folders,
      no recipient accounts, no permanent upload sitting around after the job
      is done.
    </p>

    <div class="brand-hero__actions reveal reveal-delay-3">
      <a
        href="https://testflight.apple.com/join/fastshared"
        class="btn-primary"
        data-testid="hero-cta"
        target="_blank"
        rel="noopener noreferrer"
      >
        Join TestFlight
        <span aria-hidden="true">→</span>
      </a>
      <a href="#how" class="btn-ghost">
        See the flow
        <span aria-hidden="true">↓</span>
      </a>
      <a href="#agents" class="btn-ghost">
        CLI for agents
        <span aria-hidden="true">↓</span>
      </a>
    </div>

    <dl class="brand-hero__proof reveal reveal-delay-4">
      <div>
        <dt>Launch</dt>
        <dd>2 GB · 30 d</dd>
      </div>
      <div>
        <dt>Pro</dt>
        <dd>iCloud sync</dd>
      </div>
      <div>
        <dt>Storage</dt>
        <dd>Private R2</dd>
      </div>
    </dl>
  </div>
</section>
