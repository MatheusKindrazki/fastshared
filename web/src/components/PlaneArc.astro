---
/**
 * PlaneArc keeps the old component API, but now renders the v2 raster mark.
 * PNG is canonical for this logo because the approved mark depends on glow
 * and soft shading that should stay consistent across platforms.
 */

interface Props {
  size?: number;
  framed?: boolean;
  ambient?: boolean;
  bg?: string;
  class?: string;
  animate?: boolean;
  ariaLabel?: string;
  decorative?: boolean;
}

const {
  size = 80,
  framed = false,
  ambient = false,
  bg,
  class: className = '',
  animate = false,
  ariaLabel = 'FastShared mark',
  decorative = false,
} = Astro.props;

const src = framed ? '/brand/appicon-1024.png' : '/brand/logo-mark.png';
const ambientStyle = ambient
  ? `position:absolute;inset:-${Math.round(size * 0.34)}px;border-radius:50%;background:radial-gradient(circle, rgba(157,122,255,0.42) 0%, rgba(255,255,255,0.16) 34%, rgba(157,122,255,0) 70%);filter:blur(${Math.max(8, Math.round(size * 0.1))}px);pointer-events:none;`
  : '';
const frameStyle = bg
  ? `background:${bg};border-radius:22%;`
  : '';
---
<span
  class={`planearc ${className}`}
  style={`position:relative;display:inline-block;width:${size}px;height:${size}px;line-height:0;${frameStyle}`}
  data-animate={animate ? 'planearc' : undefined}
>
  {ambient && <span class="planearc-ambient" aria-hidden="true" style={ambientStyle}></span>}
  <img
    src={src}
    alt={decorative ? '' : ariaLabel}
    width={size}
    height={size}
    class={`planearc-image${framed ? ' planearc-image--framed' : ''}`}
    style={`width:${size}px;height:${size}px;`}
    aria-hidden={decorative ? 'true' : undefined}
    decoding="async"
    loading="lazy"
  />
</span>

<style>
  .planearc-image {
    display: block;
    position: relative;
    object-fit: contain;
  }

  .planearc-image--framed {
    border-radius: 22%;
    box-shadow: 0 20px 42px -30px rgba(7, 3, 24, 0.7);
  }
</style>
