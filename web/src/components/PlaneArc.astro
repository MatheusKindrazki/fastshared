---
/**
 * PlaneArc — Plane + Arc (Refined) brand mark.
 * Single brush-stroke arc ending in a sharp dart plane.
 * Gradient: fade@0 → hot@0.5 → soft@1.0.
 *
 * When `animate` is true the markup includes a particle circle at the
 * arc origin, and class hooks that drive the four-step hero sequence
 * defined in global.css.
 */

interface Props {
  size?: number;
  framed?: boolean;
  ambient?: boolean;
  bg?: string;
  class?: string;
  animate?: boolean;
  ariaLabel?: string;
  decorative?: boolean;
}

const {
  size = 80,
  framed = false,
  ambient = false,
  bg,
  class: className = '',
  animate = false,
  ariaLabel = 'FastShared mark',
  decorative = false,
} = Astro.props;

const gid = `fspa-${Math.random().toString(36).slice(2, 10)}`;

const ambientStyle = ambient
  ? `position:absolute;inset:-${Math.round(size * 0.35)}px;border-radius:50%;background:radial-gradient(circle, rgba(157,122,255,0.45) 0%, rgba(255,122,209,0.12) 45%, rgba(157,122,255,0) 70%);filter:blur(10px);pointer-events:none;`
  : '';
---
<div
  class={`planearc ${className}`}
  style={`position:relative;display:inline-block;width:${size}px;height:${size}px;line-height:0;`}
  data-animate={animate ? 'planearc' : undefined}
>
  {ambient && (
    <div aria-hidden="true" style={ambientStyle}></div>
  )}
  <svg
    viewBox="0 0 140 140"
    width={size}
    height={size}
    style="display:block;position:relative;overflow:visible;"
    role={decorative ? undefined : 'img'}
    aria-label={decorative ? undefined : ariaLabel}
    aria-hidden={decorative ? 'true' : undefined}
    focusable="false"
  >
    <defs>
      <linearGradient id={gid} x1="0%" y1="100%" x2="100%" y2="0%">
        <stop offset="0%"  stop-color="var(--violet-fade, #ff7ad1)" stop-opacity="0"/>
        <stop offset="50%" stop-color="var(--violet-hot, #9d7aff)" stop-opacity="0.9"/>
        <stop offset="100%" stop-color="var(--violet-soft, #c1a9ff)"/>
      </linearGradient>
    </defs>
    {framed && (
      <rect
        class="planearc-frame"
        x="4"
        y="4"
        width="132"
        height="132"
        rx="32"
        fill={bg ?? 'var(--surface-warm, #f5f1e6)'}
        stroke="var(--rule)"
        stroke-width="1"
      />
    )}
    <path
      class="planearc-arc"
      d="M 26 110 Q 60 98, 82 68"
      stroke={`url(#${gid})`}
      stroke-width="9"
      stroke-linecap="round"
      fill="none"
      pathLength="200"
    />
    {animate && (
      <circle
        class="planearc-particle"
        cx="26"
        cy="110"
        r="2"
        fill="var(--violet-hot, #9d7aff)"
      />
    )}
    <!--
      Static positioning via SVG transform attributes (no CSS transform here).
      The plane is wrapped so the inner <g> receives ONLY the animated translate,
      avoiding the CSS-vs-SVG-transform conflict that caused the flicker.
    -->
    <g transform="translate(85 51)">
      <g transform="scale(1.1)">
        <g class="planearc-plane">
          <path
            d="M 0 0 L 22 -26 L 14 10 L 4 4 L 0 18 L -4 4 Z"
            fill="var(--milk, #fafaff)"
          />
          <path
            d="M 4 4 L 14 10"
            stroke="var(--milk, #fafaff)"
            stroke-opacity="0.35"
            stroke-width="1"
          />
        </g>
      </g>
    </g>
  </svg>
</div>
