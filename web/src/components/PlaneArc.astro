---
/**
 * PlaneArc — v3 brand mark.
 * Paper-plane dart at the terminus of a linear-gradient arc (amber → coral fade).
 * Single source of truth for the FastShared mark. Used at all sizes.
 *
 * Spec verbatim from design-v3/screens.jsx, lines 66–102:
 *   - SVG viewBox 0 0 140 140
 *   - ambient: radial glow ::before sibling (inset -35%, blur 6px)
 *   - linearGradient: fade → hot (0.95) @ 50% → soft
 *   - framed: rounded rect 4,4 w=132 h=132 rx=32 surface0/lineStrong
 *   - arc path:  M 26 110 Q 60 98, 82 68  · width 9 · round cap
 *   - plane at translate(84,64) scale(1.1)
 */

interface Props {
  size?: number;
  framed?: boolean;
  ambient?: boolean;
  bg?: string;
  class?: string;
  animate?: boolean;
  ariaLabel?: string;
  decorative?: boolean;
}

const {
  size = 80,
  framed = false,
  ambient = false,
  bg,
  class: className = '',
  animate = false,
  ariaLabel = 'FastShared mark',
  decorative = false,
} = Astro.props;

// Unique gradient id per instance — avoids collision when multiple instances render.
const gid = `fspa-${Math.random().toString(36).slice(2, 10)}`;

// Design tokens (mirrors JSX t.*):
//   hot       → amber   (#ff9f47)
//   soft      → coral   (#ff4e7c)
//   fade      → ember / cream (low-opacity start)
//   text      → milk    (#fafaff)
//   surface0  → ink     (#070318)
//   lineStrong → rule   (white @ 8%)
// All read from CSS custom properties in global.css so they follow the palette.
const ambientStyle = ambient
  ? `position:absolute;inset:-${Math.round(size * 0.35)}px;border-radius:50%;background:radial-gradient(circle, rgba(255,159,71,0.35) 0%, rgba(255,159,71,0) 65%);filter:blur(6px);pointer-events:none;`
  : '';
---
<div
  class={`planearc ${className}`}
  style={`position:relative;display:inline-block;width:${size}px;height:${size}px;line-height:0;`}
  data-animate={animate ? 'planearc' : undefined}
>
  {ambient && (
    <div aria-hidden="true" style={ambientStyle}></div>
  )}
  <svg
    viewBox="0 0 140 140"
    width={size}
    height={size}
    style="display:block;position:relative;"
    role={decorative ? undefined : 'img'}
    aria-label={decorative ? undefined : ariaLabel}
    aria-hidden={decorative ? 'true' : undefined}
    focusable="false"
  >
    <defs>
      <linearGradient id={gid} x1="0%" y1="100%" x2="100%" y2="0%">
        <stop offset="0%"  stop-color="var(--ember, #ffc487)" stop-opacity="0"/>
        <stop offset="50%" stop-color="var(--amber, #ff9f47)" stop-opacity="0.95"/>
        <stop offset="100%" stop-color="var(--coral, #ff4e7c)"/>
      </linearGradient>
    </defs>
    {framed && (
      <rect
        x="4"
        y="4"
        width="132"
        height="132"
        rx="32"
        fill={bg ?? 'var(--ink, #070318)'}
        stroke="rgba(255,255,255,0.12)"
        stroke-width="1"
      />
    )}
    <path
      class="planearc-arc"
      d="M 26 110 Q 60 98, 82 68"
      stroke={`url(#${gid})`}
      stroke-width="9"
      stroke-linecap="round"
      fill="none"
    />
    <g transform="translate(84,64) scale(1.1)">
      <path
        d="M 0 0 L 22 -26 L 14 10 L 4 4 L 0 18 L -4 4 Z"
        fill="var(--milk, #fafaff)"
      />
      <path
        d="M 4 4 L 14 10"
        stroke="var(--milk, #fafaff)"
        stroke-opacity="0.35"
        stroke-width="1"
      />
    </g>
  </svg>
</div>
