---
// Zero-friction surface — bento grid showing app triggers.
// No cards, no borders, no shadows. Just space and type.

const triggers = [
  {
    title: 'Action Button',
    caption: 'One physical click on iPhone 15 Pro. Link in clipboard.',
    wide: true,
  },
  {
    title: 'Siri',
    caption: '"Fast share my screenshot" — hands-free.',
    wide: false,
  },
  {
    title: 'Back Tap',
    caption: 'Double-tap the back of your phone, anywhere.',
    wide: false,
  },
  {
    title: 'Universal Clipboard',
    caption: 'Copied on iPhone. Pasted on Mac. No setup.',
    wide: true,
  },
];
---
<section class="frame py-24 md:py-40" aria-labelledby="surface-heading">
  <header class="section-head reveal">
    <span class="section-num" id="surface-heading">
      Five ways to fire
    </span>
  </header>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-1">
    {triggers.map((t, i) => (
      <div
        class:list={[
          'group p-8 md:p-10 flex flex-col gap-3 rounded-[24px] transition-colors duration-300 hover:bg-charcoal/[0.02]',
          t.wide ? 'md:col-span-2' : '',
          'reveal',
          `reveal-delay-${(i % 3) + 1}`,
        ]}
      >
        <h3
          class="font-display font-semibold text-charcoal"
          style="font-size: 22px; line-height: 1.2; letter-spacing: -0.02em;"
        >
          {t.title}
        </h3>
        <p class="font-display text-[16px] leading-[1.55] text-charcoal/45 max-w-[420px]">
          {t.caption}
        </p>
      </div>
    ))}
  </div>

  <p class="mt-8 font-mono text-[12px] tracking-[0.04em] text-charcoal/30 reveal">
    + Screenshot banner when FastShared is open
  </p>
</section>
