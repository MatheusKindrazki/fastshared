---
const surfaces = [
  {
    title: 'Share Extension',
    caption: 'Open the system share sheet, choose FastShared, and leave the app you came from.',
  },
  {
    title: 'Mac menu bar',
    caption: 'Keep recent links close, copy again, revoke, or drop a new file without hunting for a window.',
  },
  {
    title: 'Clipboard-first',
    caption: 'The product ends where your next message starts: with the temporary link already copied.',
  },
  {
    title: 'Link history',
    caption: 'A structured list shows what is live, what is expiring, and what is already gone.',
  },
];
---
<section class="frame section-block" aria-labelledby="surface-heading">
  <header class="section-head reveal">
    <span class="section-num">Apple-native</span>
    <h2 id="surface-heading" class="section-title">Built around the surfaces you already use.</h2>
  </header>

  <div class="surface-grid">
    {surfaces.map((surface, i) => (
      <article
        class:list={[
          'surface-card reveal',
          `reveal-delay-${(i % 3) + 1}`,
        ]}
      >
        <h3>{surface.title}</h3>
        <p>{surface.caption}</p>
      </article>
    ))}
  </div>
</section>
