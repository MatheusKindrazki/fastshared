---
// Zero-friction surface — four cards + one whispered ghost row.
// Icons are inline Lucide SVGs (stroke-based, 1.5px).

type IconName = 'action-button' | 'siri' | 'back-tap' | 'clipboard' | 'sparkle';

interface Card {
  icon: IconName;
  title: string;
  caption: string;
}

const cards: Card[] = [
  {
    icon: 'action-button',
    title: 'Action Button',
    caption: 'iPhone 15 Pro and newer — one physical click → link in clipboard',
  },
  {
    icon: 'siri',
    title: 'Siri',
    caption: '"Fast share my screenshot" — hands-free',
  },
  {
    icon: 'back-tap',
    title: 'Back Tap',
    caption: 'Double-tap the back of your phone, anywhere in iOS',
  },
  {
    icon: 'clipboard',
    title: 'Universal Clipboard',
    caption: 'copied on iPhone, pasted on Mac seconds later — no setup',
  },
];
---
<section class="frame pt-24 md:pt-32 pb-20 md:pb-28" aria-labelledby="surface-heading">
  <header class="section-head">
    <span class="section-num" id="surface-heading">
      02 / SURFACE · FIVE WAYS TO FIRE AT ZERO FRICTION
    </span>
  </header>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-[1px] bg-white/8">
    {cards.map((card) => (
      <article class="bg-ink p-8 md:p-10 flex flex-col gap-5 min-h-[200px]">
        <span class="text-amber" aria-hidden="true">
          {card.icon === 'action-button' && (
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <rect x="5" y="2" width="14" height="20" rx="3" />
              <rect x="2" y="8" width="2" height="4" rx="1" />
              <rect x="2" y="13" width="2" height="4" rx="1" />
            </svg>
          )}
          {card.icon === 'siri' && (
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 2a4 4 0 0 0-4 4v6a4 4 0 0 0 8 0V6a4 4 0 0 0-4-4z" />
              <path d="M4 11v1a8 8 0 0 0 16 0v-1" />
              <line x1="12" y1="20" x2="12" y2="23" />
            </svg>
          )}
          {card.icon === 'back-tap' && (
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <rect x="5" y="2" width="14" height="20" rx="3" />
              <circle cx="12" cy="12" r="3" fill="currentColor" opacity="0.35" />
              <circle cx="12" cy="12" r="6" opacity="0.5" />
            </svg>
          )}
          {card.icon === 'clipboard' && (
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <rect x="8" y="2" width="8" height="4" rx="1" />
              <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2" />
              <path d="M9 14l2 2 4-4" />
            </svg>
          )}
        </span>
        <h3
          class="font-display font-semibold text-milk"
          style="font-size: 20px; line-height: 1.25; letter-spacing: -0.02em;"
        >
          {card.title}
        </h3>
        <p class="font-mono text-[13px] leading-[1.65] tracking-[0.02em] text-milk/60">
          {card.caption}
        </p>
      </article>
    ))}
  </div>

  <!-- whispered ghost row, full width, no chrome -->
  <p class="mt-10 font-mono text-[12px] leading-[1.6] tracking-[0.04em] text-milk/40">
    <span class="text-amber" aria-hidden="true">+</span> Screenshot banner · automatic when FastShared is open
  </p>
</section>
