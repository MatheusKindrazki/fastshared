---
// Live Activity moment — stateful product preview without marketing chrome.
---
<section class="frame section-block" aria-labelledby="island-heading">
  <div class="island-layout">
    <div class="reveal">
      <span class="section-num">Live Activity</span>
      <h2 id="island-heading" class="island-title">
        Progress without opening the app.
      </h2>
      <p class="island-copy">
        Watch upload progress, copied state, and expiry from the Lock Screen
        or Dynamic Island. On Mac, the same link state stays in the menu bar.
      </p>
    </div>

    <div class="island-preview reveal reveal-delay-2" data-island-root>
      <div class="island-phone">
        <div class="island-pill">
          <div class="island-state absolute inset-0 flex items-center gap-3 px-4" data-state="uploading">
            <svg width="20" height="20" viewBox="0 0 48 48" class="flex-none" aria-hidden="true">
              <circle cx="24" cy="24" r="18" fill="none" stroke="rgba(157,122,255,0.18)" stroke-width="3" />
              <circle cx="24" cy="24" r="18" fill="none" stroke="#9d7aff" stroke-width="3" stroke-linecap="round" stroke-dasharray="113" stroke-dashoffset="33" transform="rotate(-90 24 24)" />
            </svg>
            <span class="font-mono text-[10px] uppercase text-white/50">uploading</span>
            <span class="font-mono text-[13px] font-medium text-violet-hot tabular-nums">71%</span>
          </div>

          <div class="island-state absolute inset-0 flex items-center gap-3 px-4" data-state="completed">
            <svg width="18" height="18" viewBox="0 0 40 40" class="flex-none" aria-hidden="true">
              <circle cx="20" cy="20" r="18" fill="none" stroke="#64d2a4" stroke-width="2.4" />
              <path d="M13 20.5 L18 26 L27.5 15" fill="none" stroke="#64d2a4" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <span class="font-mono text-[10px] uppercase text-white/50">copied</span>
            <span class="font-mono text-[11px] text-white truncate">fastsha.red/s/abc...</span>
          </div>

          <div class="island-state absolute inset-0 flex items-center gap-3 px-4" data-state="deleted">
            <span class="w-2 h-2 rounded-full bg-coral" aria-hidden="true"></span>
            <span class="font-mono text-[10px] uppercase text-white/35">expired</span>
            <span class="font-mono text-[14px] text-coral">410</span>
          </div>
        </div>

        <div class="island-screen">
          <div class="island-appbar">
            <img src="/brand/appicon-1024.png" alt="" width="24" height="24" aria-hidden="true" />
            <span>FastShared</span>
          </div>

          <div class="island-list">
            <div class="island-row island-row--live">
              <span class="island-file">design-v3.fig</span>
              <strong>12h left</strong>
            </div>
            <div class="island-row">
              <span class="island-file">notes.pdf</span>
              <strong>expired</strong>
            </div>
            <div class="island-row">
              <span class="island-file">screen.mov</span>
              <strong>copied</strong>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
