---
// Dynamic Island moment — integrated inside a realistic iPhone frame.
// States cycle every 4s. Under reduced-motion, shows "completed" statically.
---
<section class="frame py-24 md:py-40" aria-labelledby="island-heading">
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-24 items-center">
    <!-- copy -->
    <div class="reveal">
      <span class="mono-eyebrow block mb-6">Live Activities</span>
      <h2
        id="island-heading"
        class="font-display text-charcoal"
        style="font-size: clamp(36px, 5.5vw, 72px); line-height: 0.95; letter-spacing: -0.05em;"
      >
        <span class="block font-bold">Live in the Island.</span>
        <span class="block font-light text-charcoal/50">Watch your upload breathe.</span>
      </h2>
      <p class="mt-8 font-display text-[16px] leading-[1.6] text-charcoal/45 max-w-[400px]">
        iPhone 14 Pro and newer. Lock Screen on any iPhone. See progress, completion, and expiry — without opening the app.
      </p>
    </div>

    <!-- iPhone with Dynamic Island -->
    <div class="relative mx-auto w-full max-w-[320px] reveal reveal-delay-2" data-island-root>
      <div
        class="relative mx-auto aspect-[9/19.5] w-full rounded-[48px] overflow-hidden"
        style="background: var(--canvas); border: 1px solid var(--rule); box-shadow: var(--shadow-lg);"
      >
        <!-- Dynamic Island -->
        <div
          class="absolute left-1/2 -translate-x-1/2 top-5 h-[36px] min-w-[120px] rounded-[20px] z-20 flex items-center"
          style="background: #0d0d0d;"
        >
          <!-- state 1: uploading -->
          <div class="island-state absolute inset-0 flex items-center gap-3 px-4" data-state="uploading">
            <svg width="20" height="20" viewBox="0 0 48 48" class="flex-none" aria-hidden="true">
              <circle cx="24" cy="24" r="18" fill="none" stroke="rgba(157,122,255,0.18)" stroke-width="3" />
              <circle cx="24" cy="24" r="18" fill="none" stroke="#9d7aff" stroke-width="3" stroke-linecap="round" stroke-dasharray="113" stroke-dashoffset="33" transform="rotate(-90 24 24)" />
            </svg>
            <span class="font-mono text-[10px] tracking-[0.1em] uppercase text-white/50">uploading</span>
            <span class="font-mono text-[13px] font-medium text-violet-hot tabular-nums">71%</span>
          </div>

          <!-- state 2: completed -->
          <div class="island-state absolute inset-0 flex items-center gap-3 px-4" data-state="completed">
            <svg width="18" height="18" viewBox="0 0 40 40" class="flex-none" aria-hidden="true">
              <circle cx="20" cy="20" r="18" fill="none" stroke="#9d7aff" stroke-width="2.4" />
              <path d="M13 20.5 L18 26 L27.5 15" fill="none" stroke="#9d7aff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <span class="font-mono text-[10px] tracking-[0.1em] uppercase text-white/50">copied</span>
            <span class="font-mono text-[11px] text-white truncate">fastsha.red/s/abc…</span>
          </div>

          <!-- state 3: expired -->
          <div class="island-state absolute inset-0 flex items-center gap-3 px-4" data-state="deleted">
            <div class="flex-none flex items-center gap-1" aria-hidden="true">
              <span class="w-1.5 h-1.5 rounded-full bg-coral opacity-90"></span>
              <span class="w-1 h-1 rounded-full bg-coral opacity-50"></span>
            </div>
            <span class="font-mono text-[10px] tracking-[0.1em] uppercase text-white/35">expired</span>
            <span class="font-mono text-[14px] text-coral">—</span>
          </div>
        </div>

        <!-- Screen content -->
        <div class="w-full h-full pt-20 px-5 flex flex-col gap-4">
          <!-- App header -->
          <div class="flex items-center justify-between">
            <span class="font-display text-[14px] font-semibold text-charcoal">FastShared</span>
            <div class="w-7 h-7 rounded-full bg-charcoal/5"></div>
          </div>
          <!-- History list -->
          <div class="flex flex-col gap-3">
            <div class="flex items-center gap-3 p-3 rounded-xl" style="background: var(--surface-warm);">
              <div class="w-8 h-8 rounded-lg bg-violet-hot/10 flex items-center justify-center flex-none">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--violet-hot)" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
              </div>
              <div class="flex-1 min-w-0">
                <p class="font-display text-[13px] font-medium text-charcoal truncate">design-v3.fig</p>
                <p class="font-mono text-[10px] text-charcoal/35">12h left</p>
              </div>
            </div>
            <div class="flex items-center gap-3 p-3 rounded-xl" style="background: var(--surface-warm); opacity: 0.5;">
              <div class="w-8 h-8 rounded-lg bg-charcoal/5 flex items-center justify-center flex-none">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--tin)" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
              </div>
              <div class="flex-1 min-w-0">
                <p class="font-display text-[13px] font-medium text-charcoal truncate line-through">notes.pdf</p>
                <p class="font-mono text-[10px] text-charcoal/35">expired</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
