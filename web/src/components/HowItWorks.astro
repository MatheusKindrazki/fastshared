---
const steps = [
  {
    n: '01',
    title: 'Pick the file',
    caption: 'Share sheet on iPhone and iPad. Drag, drop, or paste on Mac.',
    meta: 'Any supported file',
  },
  {
    n: '02',
    title: 'Set the deadline',
    caption: 'Default 24 hours. Pro can keep links alive up to 30 days.',
    meta: 'Expiry is required',
  },
  {
    n: '03',
    title: 'Paste the link',
    caption: 'The short URL lands on your clipboard while the upload finishes.',
    meta: 'fastsha.red/s/...',
  },
];
---
<section id="how" class="frame section-block" aria-labelledby="how-heading">
  <header class="section-head">
    <span class="section-num">Flow</span>
    <h2 id="how-heading" class="section-title">One gesture. Three states.</h2>
  </header>

  <div class="flow-grid">
    {steps.map((step, i) => (
      <article
        class:list={[
          'flow-card reveal',
          `reveal-delay-${i + 1}`,
        ]}
      >
        <div class="flow-card__top">
          <span class="flow-card__number" aria-hidden="true">{step.n}</span>
          <span class="flow-card__meta">{step.meta}</span>
        </div>
        <h3>{step.title}</h3>
        <p>{step.caption}</p>
      </article>
    ))}
  </div>
</section>
