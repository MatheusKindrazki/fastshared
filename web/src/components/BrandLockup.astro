---
/**
 * BrandLockup - app icon tile + visual wordmark.
 * Textual metadata still uses "FastShared"; the lockup is the brand glyph.
 */

interface Props {
  markSize?: number;
  textSize?: number;
  class?: string;
  ariaLabel?: string;
}

const {
  markSize = 22,
  textSize = 15,
  class: className = '',
  ariaLabel = 'FastShared',
} = Astro.props;
---
<span
  class={`brand-lockup inline-flex items-center ${className}`}
  style={`gap:${Math.max(8, Math.round(markSize * 0.36))}px;`}
  aria-label={ariaLabel}
>
  <img
    src="/brand/appicon-1024.png"
    alt=""
    width={markSize}
    height={markSize}
    class="brand-lockup__icon"
    style={`width:${markSize}px;height:${markSize}px;`}
    decoding="async"
    loading="lazy"
    aria-hidden="true"
  />
  <span
    class="font-display font-bold"
    style={`font-size:${textSize}px;letter-spacing:0;line-height:1;`}
  >
    fastshared<span class="brand-lockup__dot">.</span>
  </span>
</span>

<style>
  .brand-lockup__icon {
    display: block;
    border-radius: 22%;
    box-shadow: 0 8px 18px -12px rgba(15, 12, 34, 0.45);
  }

  .brand-lockup__dot {
    color: #9d7aff;
  }
</style>
