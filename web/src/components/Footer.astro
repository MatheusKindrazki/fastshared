---
// Minimal footer — mark on the left, plain links on the right.
---
<footer class="frame pt-16 pb-12 mt-20 border-t border-white/8">
  <div class="flex flex-col md:flex-row gap-6 md:gap-4 items-start md:items-center justify-between">
    <div class="flex items-center gap-4">
      <img
        src="/brand/logo-mark.svg"
        alt=""
        width="32"
        height="32"
        class="w-7 h-7"
        style="color: var(--milk);"
        decoding="async"
        loading="lazy"
      />
      <span class="font-mono text-[12px] tracking-[0.08em] uppercase text-milk/40">
        fastshared · 2026 · v0.1
      </span>
    </div>

    <nav class="flex items-center gap-6 text-[13px]" aria-label="Footer">
      <a href="/press" class="font-mono tracking-[0.06em] uppercase text-milk/50 hover:text-amber transition-colors">press</a>
      <a href="/privacy" class="font-mono tracking-[0.06em] uppercase text-milk/50 hover:text-amber transition-colors">privacy</a>
      <a href="/terms" class="font-mono tracking-[0.06em] uppercase text-milk/50 hover:text-amber transition-colors">terms</a>
      <a href="https://github.com/MatheusKindrazki/fastshared" rel="noopener noreferrer" target="_blank" class="font-mono tracking-[0.06em] uppercase text-milk/50 hover:text-amber transition-colors">github ↗</a>
    </nav>
  </div>
</footer>
