---
import BrandLockup from './BrandLockup.astro';

// Fixed navigation with the shipped app icon as the public brand mark.
---
<nav
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-300"
  id="main-nav"
  aria-label="Primary"
>
  <div class="frame flex items-center justify-between py-4">
    <a
      href="/"
      aria-label="FastShared home"
      class="nav-brand inline-flex items-center gap-3 transition-colors"
    >
      <BrandLockup markSize={34} textSize={16} ariaLabel="FastShared home" />
    </a>

    <div class="flex items-center gap-5">
      <a
        href="/pricing/"
        class="nav-link font-mono text-[12px] uppercase transition-colors hidden sm:inline-flex"
        data-testid="nav-pricing"
      >
        Pricing
      </a>
      <a
        href="/#agents"
        class="nav-link font-mono text-[12px] uppercase transition-colors hidden md:inline-flex"
      >
        CLI
      </a>
      <a
        href="https://apps.apple.com/app/id6762569167"
        class="nav-link font-mono text-[12px] uppercase transition-colors hidden sm:inline-flex items-center gap-2"
        data-testid="nav-testflight"
        target="_blank"
        rel="noopener noreferrer"
      >
        App Store <span aria-hidden="true">→</span>
      </a>
      <button
        type="button"
        class="theme-toggle"
        aria-label="Toggle theme"
        title="Toggle theme"
      >
        <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="5" />
          <path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42" />
        </svg>
        <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
        </svg>
      </button>
    </div>
  </div>
</nav>

<style>
  #main-nav {
    --nav-fg: var(--charcoal);
    --nav-muted: rgba(var(--charcoal-rgb), 0.55);
    --nav-toggle-bg: rgba(var(--canvas-rgb), 0.62);
    --nav-toggle-border: var(--rule);
    color: var(--nav-fg);
  }

  #main-nav.nav-on-dark {
    --nav-fg: #fafaff;
    --nav-muted: rgba(250, 250, 255, 0.68);
    --nav-toggle-bg: rgba(250, 250, 255, 0.07);
    --nav-toggle-border: rgba(250, 250, 255, 0.16);
    background:
      linear-gradient(180deg, rgba(7, 3, 24, 0.88), rgba(7, 3, 24, 0.66));
    border-bottom: 1px solid rgba(250, 250, 255, 0.10);
    backdrop-filter: blur(20px) saturate(1.5);
    -webkit-backdrop-filter: blur(20px) saturate(1.5);
  }

  .nav-brand {
    color: var(--nav-fg);
  }

  .nav-link {
    color: var(--nav-muted);
  }

  .nav-link:hover,
  .nav-brand:hover { color: var(--violet-hot); }

  .theme-toggle {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: 10px;
    background: var(--nav-toggle-bg);
    border: 1px solid var(--nav-toggle-border);
    color: var(--nav-fg);
    cursor: pointer;
    transition: background 0.2s, border-color 0.2s, color 0.2s;
  }
  .theme-toggle:hover {
    background: var(--surface-warm);
    border-color: var(--violet-hot);
    color: var(--violet-hot);
  }
  .theme-toggle .icon-sun,
  .theme-toggle .icon-moon {
    position: absolute;
    transition: opacity 0.2s, transform 0.2s;
  }
  .theme-toggle .icon-sun { opacity: 1; transform: scale(1); }
  .theme-toggle .icon-moon { opacity: 0; transform: scale(0.8); }

  [data-theme="dark"] .theme-toggle .icon-sun { opacity: 0; transform: scale(0.8); }
  [data-theme="dark"] .theme-toggle .icon-moon { opacity: 1; transform: scale(1); }
</style>

<script>
  (function () {
    var btn = document.querySelector('.theme-toggle');
    if (!btn) return;
    btn.addEventListener('click', function () {
      var html = document.documentElement;
      var isDark = html.getAttribute('data-theme') === 'dark';
      if (isDark) {
        html.removeAttribute('data-theme');
        localStorage.setItem('fs-theme', 'light');
      } else {
        html.setAttribute('data-theme', 'dark');
        localStorage.setItem('fs-theme', 'dark');
      }
      window.dispatchEvent(new CustomEvent('fs-theme-change'));
      var themeColor = document.querySelector('meta[name="theme-color"]');
      if (themeColor) {
        themeColor.setAttribute('content', isDark ? '#fbf8f1' : '#0f0f12');
      }
    });
  })();
</script>
