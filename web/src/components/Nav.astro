---
// Tiny, non-sticky navigation.
// Uses /brand/logo-horizontal.svg (Plane + Arc Refined) on the left,
// plain links on the right with violet-hot hover states.
---
<nav class="frame flex items-center justify-between py-6" aria-label="Primary">
  <a
    href="/"
    aria-label="fastshared — home"
    class="inline-flex items-center text-milk transition-colors nav-brand"
    style="color: var(--milk);"
  >
    <img
      src="/brand/logo-horizontal.svg"
      alt="fastshared"
      width="180"
      height="32"
      style="height:28px;width:auto;display:block;"
      decoding="async"
    />
  </a>

  <div class="flex items-center gap-6">
    <a
      href="/pricing"
      class="nav-link font-mono text-[13px] tracking-wider uppercase text-milk/70 transition-colors"
      data-testid="nav-pricing"
    >
      Pricing
    </a>
    <a
      href="#testflight"
      class="nav-link font-mono text-[13px] tracking-wider uppercase text-milk/70 transition-colors flex items-center gap-2"
      data-testid="nav-testflight"
    >
      TestFlight <span aria-hidden="true">→</span>
    </a>
  </div>
</nav>

<style>
  .nav-link:hover,
  .nav-brand:hover { color: var(--violet-hot); }
</style>
