---
import '../styles/global.css';

export interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  noindex?: boolean;
}

/*
 * App Store facts — verified against Apple's public lookup API:
 *   itunes.apple.com/lookup?bundleId=dev.kindrazki.fastshared
 * Keep these in sync with the store listing; nothing here is inferred.
 */
const APP_STORE_ID = '6762569167';
const APP_STORE_URL = `https://apps.apple.com/app/id${APP_STORE_ID}`;
const APP_BUNDLE_ID = 'dev.kindrazki.fastshared';
const APP_VERSION = '1.0.3';
const APP_RELEASE_DATE = '2026-06-15';

/* The app's own description, independent of whichever page is rendering.
   Doubles as the default page description so the two can never drift. */
const APP_DESCRIPTION =
  'Share anything. Get a link. Watch it vanish. FastShared creates temporary file links for iPhone, iPad, and Mac.';

const {
  title = 'FastShared — temporary file links for Apple devices.',
  description = APP_DESCRIPTION,
  canonical,
  ogImage = '/og-image.png',
  noindex = false,
} = Astro.props;

const pageUrl = canonical ?? new URL(Astro.url.pathname, Astro.site ?? 'https://fastsha.red').toString();
const ogImageUrl = new URL(ogImage, Astro.site ?? 'https://fastsha.red').toString();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />

    {/* Theme hydration — runs before render to prevent FOUC */}
    <script is:inline>
      (function () {
        var stored = localStorage.getItem('fs-theme');
        var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        var isDark = stored === 'dark' || (!stored && prefersDark);
        if (isDark) {
          document.documentElement.setAttribute('data-theme', 'dark');
        }
        var themeColor = document.querySelector('meta[name="theme-color"]');
        if (themeColor) {
          themeColor.setAttribute('content', isDark ? '#0f0f12' : '#fbf8f1');
        }
      })();
    </script>

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={pageUrl} />

    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#fbf8f1" />
    <meta name="author" content="Matheus Kindrazki" />

    {/* Smart App Banner — Safari on iOS/iPadOS offers the app directly.
        No app-argument: there is no verified deep-link scheme to hand over. */}
    <meta name="apple-itunes-app" content={`app-id=${APP_STORE_ID}`} />

    {/* Favicon + app icons */}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/brand/appicon-1024.png" />
    <link rel="mask-icon" href="/brand/logo-mark.svg" color="#9d7aff" />

    {/* Open Graph */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="FastShared" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_US" />

    {/* Twitter */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    {/* Fonts — Google Fonts, variable Bricolage + JetBrains Mono */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,300;12..96,400;12..96,500;12..96,600;12..96,700&family=JetBrains+Mono:wght@500&display=swap"
      rel="stylesheet"
    />

    {/* Structured data — SoftwareApplication.
        No aggregateRating: one review is not a rating signal, and publishing it
        would be self-promotional markup Google treats as spammy. */}
    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'SoftwareApplication',
      name: 'FastShared',
      description: APP_DESCRIPTION,
      url: 'https://fastsha.red',
      /* installUrl: "URL at which the app may be installed, if different from the
         URL of the item." The store page is where installation happens — unlike
         downloadUrl, which schema.org defines as a URL to download the binary. */
      installUrl: APP_STORE_URL,
      /* sameAs: "URL of a reference Web page that unambiguously indicates the
         item's identity." The App Store listing is that authoritative page. */
      sameAs: APP_STORE_URL,
      identifier: [
        { '@type': 'PropertyValue', propertyID: 'appStoreId', value: APP_STORE_ID },
        { '@type': 'PropertyValue', propertyID: 'bundleId', value: APP_BUNDLE_ID },
      ],
      /* Free text (schema.org publishes no enumeration for this property), so it
         carries the App Store's primary category verbatim. */
      applicationCategory: 'Productivity',
      /* minimumOsVersion 17.0 + iosUniversal (iPhone/iPad); Mac is in
         supportedDevices, but Apple reports no minimum macOS version. */
      operatingSystem: 'iOS 17.0, iPadOS 17.0, macOS',
      softwareVersion: APP_VERSION,
      datePublished: APP_RELEASE_DATE,
      /* The download itself is free; Pro is sold as in-app purchase, and no
         verified IAP price belongs in this node. */
      offers: {
        '@type': 'Offer',
        price: '0',
        priceCurrency: 'USD',
        url: APP_STORE_URL,
      },
    })} />

  </head>
  <body style="padding-top: 72px;">
    <slot />
  </body>
</html>
