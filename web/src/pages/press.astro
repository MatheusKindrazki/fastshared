---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import PlaneArc from '../components/PlaneArc.astro';

interface Swatch {
  name: string;
  hex: string;
  role: string;
  onLight?: boolean;
}

/* The shipped palette, not the pre-redesign one. This table is the version a
   journalist quotes, so it lists only tokens with measured consumers in src/ —
   the old entries (ink #070318, nightshade, milk #fafaff, violet-soft, warning)
   were retired with the neutral two-pole system and have zero uses today.
   The grounds and text tiers invert between poles, so both values are published;
   violet-hot is the one colour that is the same in both. */
const palette: Swatch[] = [
  { name: 'cream / light',    hex: '#fbf8f1', role: 'ground — light pole (default)', onLight: true },
  { name: 'cream / dark',     hex: '#0f0f12', role: 'ground — dark pole' },
  { name: 'charcoal / light', hex: '#1d1d1f', role: 'text on the light ground' },
  { name: 'charcoal / dark',  hex: '#f0f0f5', role: 'text on the dark ground',       onLight: true },
  { name: 'silver',           hex: '#6e6e73', role: 'labels, mono, secondary text' },
  { name: 'violet-hot',       hex: '#9d7aff', role: 'the accent — same in both poles', onLight: true },
  { name: 'accent-surface',   hex: '#3b1f86', role: 'accent as a surface (light pole)' },
  { name: 'coral',            hex: '#ff4e7c', role: 'endings — expiry, deletion' },
];

interface Asset {
  label: string;
  href: string;
  meta: string;
}

const assets: Asset[] = [
  { label: 'App icon (1024 × 1024)',           href: '/brand/appicon-1024.png',         meta: 'PNG · full bleed · App Store' },
  { label: 'Lockup — transparent',             href: '/brand/logo-horizontal.png',       meta: 'PNG · 2400 × 800 · transparent' },
  { label: 'Lockup — horizontal, dark bg',      href: '/brand/wordmark-horizontal-dark.png',  meta: 'PNG · 2400 × 800 · ink background' },
  { label: 'Lockup — horizontal, light bg',     href: '/brand/wordmark-horizontal-light.png', meta: 'PNG · 2400 × 800 · light background' },
  { label: 'Mark only',                         href: '/brand/wordmark-mark.png',         meta: 'PNG · 1024 × 1024 · transparent' },
  { label: 'Social card / OG image',           href: '/brand/og-image.png',              meta: 'PNG · 1200 × 630' },
  { label: 'Wordmark (vector)',                href: '/brand/logo-horizontal.svg',        meta: 'SVG · inherits currentColor' },
  { label: 'Mark (vector)',                    href: '/brand/logo-mark.svg',              meta: 'SVG · transparent background' },
  { label: 'App icon (vector)',                href: '/brand/appicon.svg',                meta: 'SVG · 1024 × 1024 full bleed' },
];
---
<Base
  title="Press — FastShared"
  description="Press kit, brand assets, and boilerplate for journalists covering FastShared."
>
  <Nav />
  <main class="frame pt-16 pb-24">

    <!-- Hero -->
    <section class="max-w-[920px] mb-24 md:mb-32">
      <div class="mb-10">
        <PlaneArc size={120} framed ambient ariaLabel="FastShared mark" />
      </div>
      <p class="font-mono text-[12px] tracking-[0.1em] uppercase text-violet-hot mb-6">
        Press kit · v2.0 · 2026
      </p>
      <h1
        class="font-display font-bold text-milk mb-8"
        style="font-size: clamp(44px, 7vw, 96px); line-height: 0.95; letter-spacing: -0.04em;"
      >
        FastShared in one sentence.
      </h1>
      <p class="text-milk/80 text-[21px] md:text-[24px] leading-[1.45] font-display font-light max-w-[780px]" style="letter-spacing: -0.01em;">
        FastShared is a native Apple utility that turns "share a file" into
        "get a temporary link on my clipboard" in one gesture — ephemeral by
        design, private by default, Apple-native in every surface.
      </p>

      <div class="mt-10 prose-like text-milk/65 text-[17px] leading-[1.7] max-w-[720px]">
        <p>
          We built FastShared because everyday file sharing on Apple devices
          should cost one gesture and should not leave permanent residue on
          the internet. Every link has an expiry you pick. When the window
          ends, the link returns
          <code class="font-mono text-[14px] text-violet-hot">410 Gone</code> and
          the underlying file is hard-deleted from a private Cloudflare R2
          bucket. No accounts. No tracking. No "keep forever" option.
          That's the product.
        </p>
      </div>
    </section>

    <!-- Quick facts -->
    <section class="mb-24 md:mb-32">
      <header class="section-head">
        <span class="section-num">01 / QUICK FACTS</span>
      </header>
      <dl class="grid grid-cols-1 md:grid-cols-2 gap-y-6 gap-x-12 max-w-[860px]">
        <div>
          <dt class="font-mono text-[11px] tracking-[0.14em] uppercase text-milk/45 mb-2">Platforms</dt>
          <dd class="text-milk/85 text-[17px]">iOS 17+, iPadOS 17+, macOS 14+</dd>
        </div>
        <div>
          <dt class="font-mono text-[11px] tracking-[0.14em] uppercase text-milk/45 mb-2">Launch date</dt>
          <dd class="text-milk/85 text-[17px]">June 15, 2026 — App Store 1.0 (current 1.0.3)</dd>
        </div>
        <div>
          <dt class="font-mono text-[11px] tracking-[0.14em] uppercase text-milk/45 mb-2">Category</dt>
          <dd class="text-milk/85 text-[17px]">Productivity</dd>
        </div>
        <div>
          <dt class="font-mono text-[11px] tracking-[0.14em] uppercase text-milk/45 mb-2">Maker</dt>
          <dd class="text-milk/85 text-[17px]">Matheus Kindrazki (independent)</dd>
        </div>
        <div>
          <dt class="font-mono text-[11px] tracking-[0.14em] uppercase text-milk/45 mb-2">Pricing</dt>
          <dd class="text-milk/85 text-[17px]">Free download. Pro is an in-app purchase: $2.99/month or $19.99/year (auto-renewing), or $49.99 once for Lifetime.</dd>
        </div>
        <div>
          <dt class="font-mono text-[11px] tracking-[0.14em] uppercase text-milk/45 mb-2">Stack</dt>
          <dd class="text-milk/85 text-[17px]">SwiftUI + SwiftData · Cloudflare Workers (Hono) · R2 · Neon Postgres</dd>
        </div>
        <div>
          <dt class="font-mono text-[11px] tracking-[0.14em] uppercase text-milk/45 mb-2">Landing</dt>
          <dd class="text-milk/85 text-[17px]"><a href="https://fastsha.red" class="text-violet-hot hover:underline">fastsha.red</a></dd>
        </div>
        <div>
          <dt class="font-mono text-[11px] tracking-[0.14em] uppercase text-milk/45 mb-2">App Store</dt>
          <dd class="text-milk/85 text-[17px]"><a href="https://apps.apple.com/app/id6762569167" target="_blank" rel="noopener noreferrer" class="text-violet-hot hover:underline">apps.apple.com/app/id6762569167</a></dd>
        </div>
        <div>
          <dt class="font-mono text-[11px] tracking-[0.14em] uppercase text-milk/45 mb-2">Short links</dt>
          <dd class="text-milk/85 text-[17px]"><code class="font-mono text-[15px]">fastsha.red/s/&lt;token&gt;</code></dd>
        </div>
        <div>
          <dt class="font-mono text-[11px] tracking-[0.14em] uppercase text-milk/45 mb-2">Press contact</dt>
          <dd class="text-milk/85 text-[17px]">
            <a href="mailto:press@fastsha.red" class="text-violet-hot hover:underline">press@fastsha.red</a>
          </dd>
        </div>
        <div>
          <dt class="font-mono text-[11px] tracking-[0.14em] uppercase text-milk/45 mb-2">Repo</dt>
          <dd class="text-milk/85 text-[17px]">Private at launch. Will open post-1.0.</dd>
        </div>
      </dl>
    </section>

    <!-- Downloadable assets -->
    <section class="mb-24 md:mb-32">
      <header class="section-head">
        <span class="section-num">02 / DOWNLOADS</span>
      </header>
      <p class="text-milk/60 text-[15px] max-w-[640px] mb-8">
        Logo, mark, and icon exports. Please do not recolor the arc — the
        violet-to-coral fade is the concept. Full identity spec lives at
        <code class="font-mono text-[13px] text-violet-hot">brand/README.md</code>
        in the repository.
      </p>
      <ul class="grid grid-cols-1 md:grid-cols-2 gap-[1px] bg-white/8 max-w-[960px]">
        {assets.map((asset) => (
          <li class="bg-ink p-6 md:p-7 flex flex-col gap-2 hover:bg-[#0d0622] transition-colors">
            <a href={asset.href} download class="font-display font-semibold text-milk hover:text-violet-hot transition-colors text-[17px]" style="letter-spacing: -0.01em;">
              {asset.label}
              <span class="ml-2 text-violet-hot" aria-hidden="true">↓</span>
            </a>
            <span class="font-mono text-[12px] tracking-[0.04em] text-milk/45">{asset.meta}</span>
          </li>
        ))}
      </ul>
    </section>

    <!-- Palette -->
    <section class="mb-24 md:mb-32">
      <header class="section-head">
        <span class="section-num">03 / PALETTE</span>
      </header>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-[1px] bg-white/8 max-w-[960px]">
        {palette.map((swatch) => (
          <div class="bg-ink p-5 flex flex-col gap-4">
            <span
              class="block aspect-square w-full rounded-sm"
              style={`background: ${swatch.hex}; box-shadow: inset 0 0 0 1px rgba(255,255,255,${swatch.onLight ? 0.06 : 0});`}
              aria-hidden="true"
            ></span>
            <div class="flex flex-col gap-1">
              <span class="font-display font-semibold text-milk text-[15px]">{swatch.name}</span>
              <span class="font-mono text-[11px] tracking-[0.05em] text-milk/55 uppercase">{swatch.hex}</span>
              <span class="font-mono text-[11px] tracking-[0.05em] text-milk/40">{swatch.role}</span>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Boilerplate -->
    <section class="mb-20">
      <header class="section-head">
        <span class="section-num">04 / BOILERPLATE</span>
      </header>
      <p class="text-milk/60 text-[13px] mb-6 font-mono tracking-[0.06em] uppercase">
        Paste-ready blurb for journalists · ≤ 100 words
      </p>
      <blockquote class="text-milk/85 text-[18px] md:text-[20px] leading-[1.65] font-display font-light max-w-[780px] border-l-2 border-violet-hot pl-6" style="letter-spacing: -0.005em;">
        FastShared is a native iOS, iPadOS, and macOS utility that collapses
        the everyday "share a file" chore into one gesture. Any file from any
        app becomes a temporary short URL on your clipboard, with a
        configurable expiry from 5 minutes to 30 days — default 24 hours.
        When the window closes the link stops resolving and the underlying
        file is hard-deleted from a private Cloudflare R2 bucket. No
        accounts, no folders, no tracking. Built by independent developer
        Matheus Kindrazki on SwiftUI and Cloudflare Workers.
      </blockquote>
      <p class="mt-6 text-milk/45 text-[13px] font-mono">
        <span class="text-milk/70">92 words.</span> Edits welcome so long as the
        "ephemeral by design" line survives — it is the product.
      </p>
    </section>

  </main>
  <Footer />
</Base>
