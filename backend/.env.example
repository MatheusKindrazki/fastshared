DATABASE_URL=postgres://user:password@host/db?sslmode=require
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=fastshared-prod
DEVICE_TOKEN_PEPPER=
SHORT_LINK_HOST=https://fastsha.red
PUBLIC_API_HOST=https://api.fastsha.red

# App Store Connect API credentials (Pro subscriptions IAP verify + webhook).
# Create an API Key with "In-App Purchase" access at
# https://appstoreconnect.apple.com/access/api — the Key ID and Issuer ID are
# visible on that page; download the .p8 file once and base64-encode it:
#   base64 -i AuthKey_XXXXXX.p8 | tr -d '\n'
APP_STORE_CONNECT_KEY_ID=
APP_STORE_CONNECT_ISSUER_ID=
APP_STORE_CONNECT_P8_KEY_BASE64=
# Public — must match apple/Config/Shared.xcconfig PRODUCT_BUNDLE_IDENTIFIER_PREFIX.
# Apple puts this in the JWT aud claim for Sign in with Apple.
APPLE_BUNDLE_ID=dev.kindrazki.fastshared
