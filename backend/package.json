{
  "name": "fastshared-backend",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "lint": "tsc --noEmit && prettier -c src",
    "format": "prettier -w src"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1036.0",
    "@aws-sdk/s3-request-presigner": "^3.1036.0",
    "@neondatabase/serverless": "^0.10.1",
    "@peculiar/x509": "^2.0.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.6.5",
    "jose": "^6.2.2",
    "reflect-metadata": "^0.2.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.15.0",
    "@cloudflare/workers-types": "^4.20260424.1",
    "@types/node": "^22.7.5",
    "drizzle-kit": "^0.31.10",
    "prettier": "^3.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.0.10",
    "vitest": "^4.1.5",
    "wrangler": "^4.85.0"
  },
  "overrides": {
    "esbuild": "^0.25.12"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "^0.25.12"
    }
  }
}
