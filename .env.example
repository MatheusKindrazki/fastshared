# FastShared environment variables (repo-level union).
#
# Apple targets read configuration from xcconfig files under apple/Config/,
# not from this file. This file documents the backend's required variables
# so that local development + CI can stay consistent.
#
# Copy this file to .env (for docs / tooling) and to backend/.dev.vars
# (consumed by Wrangler during `pnpm dev`). Never commit real secrets.

# --- Database ---
# Neon Postgres HTTP URL (pooled). Used by the Drizzle Neon HTTP driver.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# --- Cloudflare R2 (S3-compat) ---
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=fastshared-dev

# --- Device token hashing pepper ---
# Server-side secret mixed into HMAC-SHA256 of device bearer tokens.
# Rotate by adding a new pepper and migrating hashes; never expose.
DEVICE_TOKEN_PEPPER=replace-with-32-bytes-base64

# --- Short link host (no scheme, no trailing slash) ---
# dev   -> fsh.dev
# prod  -> fsh.re
SHORT_LINK_HOST=fsh.dev

# --- Public API host (scheme + host, no trailing slash) ---
# The Apple client reads an xcconfig-derived equivalent; this variable
# is used by backend integration tests and tooling.
PUBLIC_API_HOST=https://api.fsh.dev
